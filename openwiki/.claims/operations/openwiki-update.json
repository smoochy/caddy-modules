    {
      "id": "claim_6d13ec9975c0420dad301d1be8d42fe0",
      "statement": "The openwiki-update workflow runs on a bi-weekly schedule (Thursdays 05:00 UTC) and on manual dispatch.",
      "evidence": [
        {
          "resource": "repo://.github/workflows/openwiki-update.yaml#L6-L10",
          "version": "repo-lines-v1:sha256:b0c3b8e8dcc684d863679fa4037f361050d1b739956790684aece6b3ee23b0e6:"
        }
      ]
    },
    {
      "id": "claim_429aa33ff14345d28f982c3fece4a10c",
      "statement": "The workflow uses a parity gate job that checks ISO week number parity to enforce bi-weekly execution since GitHub cron cannot express 'every other week'.",
      "evidence": [
        {
          "resource": "repo://.github/workflows/openwiki-update.yaml#L13-L32",
          "version": "repo-lines-v1:sha256:89bafebb3c68a9cdd6e49f29691f85ce785f5df24206603ca387c24bab5d1e29:"
        }
      ]
    },
    {
      "id": "claim_bbee2ab3ca58481fbfc4a98b8d3abcc6",
      "statement": "The parity gate always allows manual workflow_dispatch runs to proceed regardless of ISO week parity.",
      "evidence": [
        {
          "resource": "repo://.github/workflows/openwiki-update.yaml#L18-L21",
          "version": "repo-lines-v1:sha256:dc7ed858091e65ea1f901acc008059f0dd0f16b0fe8dcd93b67442ce7d34b5dd:"
        }
      ]
    },
    {
      "id": "claim_4e672a92040e442aae9961c739228d70",
      "statement": "The parity gate uses '10#' prefix with date +%V to force base-10 interpretation and avoid octal parsing issues with week numbers 08 and 09.",
